# Copy this file to .env and set real values:   cp .env.example .env
# .env is git-ignored and excluded from Docker builds. Never commit it.
# Docker Compose reads .env automatically from this directory.
# Avoid '$' in values (Compose treats it as variable syntax).

# --- Database (used by both the db and app services) ---
POSTGRES_DB=flags
POSTGRES_USER=flags
# Required. Generate one with:  openssl rand -hex 16
POSTGRES_PASSWORD=flags-pass

# --- Host ports ---
# Where nginx is reachable on your machine: http://localhost:HTTP_PORT
HTTP_PORT=8080
# Postgres published on 127.0.0.1 only (for IDE / psql access)
DB_HOST_PORT=5432
